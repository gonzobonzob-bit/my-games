<?xml version="1.0" encoding="UTF-8"?>
<!-- Plate Empire dish icon (PLACEHOLDER) — Elote (street corn) -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <rect x="2" y="2" width="116" height="116" rx="22" fill="#262320"/>
  <rect x="2" y="2" width="116" height="116" rx="22" fill="none" stroke="#C08A3E" stroke-width="3"/>
  <!-- stick -->
  <rect x="56" y="84" width="8" height="22" rx="4" fill="#8a5a22" transform="rotate(28 60 90)"/>
  <!-- cob -->
  <rect x="40" y="28" width="40" height="60" rx="20" fill="#f0cd82" transform="rotate(28 60 58)"/>
  <!-- kernels -->
  <g fill="#e8a14a" transform="rotate(28 60 58)">
    <circle cx="50" cy="40" r="3.2"/><circle cx="60" cy="38" r="3.2"/><circle cx="70" cy="42" r="3.2"/>
    <circle cx="48" cy="52" r="3.2"/><circle cx="60" cy="50" r="3.2"/><circle cx="72" cy="54" r="3.2"/>
    <circle cx="50" cy="64" r="3.2"/><circle cx="60" cy="62" r="3.2"/><circle cx="70" cy="66" r="3.2"/>
  </g>
  <!-- crema + chile dust -->
  <g transform="rotate(28 60 58)">
    <path d="M44 34 q16 -6 32 2" stroke="#EFE6D8" stroke-width="3" fill="none" opacity="0.8"/>
    <circle cx="52" cy="46" r="1.6" fill="#B5453A"/><circle cx="66" cy="44" r="1.6" fill="#B5453A"/><circle cx="58" cy="58" r="1.6" fill="#B5453A"/>
  </g>
</svg>
