  <rect x="2" y="2" width="116" height="116" rx="22" fill="#262320"/>
  <rect x="2" y="2" width="116" height="116" rx="22" fill="none" stroke="#C08A3E" stroke-width="3"/>
  <!-- top bun -->
  <path d="M28 52 Q60 22 92 52 Z" fill="#d99a4e"/>
  <ellipse cx="46" cy="42" rx="2.5" ry="2" fill="#EFE6D8"/><ellipse cx="62" cy="38" rx="2.5" ry="2" fill="#EFE6D8"/><ellipse cx="76" cy="44" rx="2.5" ry="2" fill="#EFE6D8"/>
  <!-- green chile + lettuce -->
  <rect x="26" y="52" width="68" height="8" rx="4" fill="#6B8E5A"/>
  <rect x="28" y="60" width="64" height="7" rx="3" fill="#8aa86f"/>
  <!-- patty -->
  <rect x="26" y="67" width="68" height="11" rx="5" fill="#5a3a22"/>
